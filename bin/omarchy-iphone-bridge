#!/usr/bin/env python3
"""Bridge between the ancs4linux ANCS daemon and the Omarchy shell.

The iPhone speaks Apple Notification Center Service over Bluetooth LE. The
ancs4linux observer daemon (running as root on the system bus) turns that into
D-Bus signals; this script turns those into newline-delimited JSON on stdout,
which the QML plugin consumes directly.

It also owns the on-disk history, because file I/O belongs here rather than in
the shell process.

Subcommands:
  listen            stream history + live events as JSONL (default)
  invoke            perform a notification action on the phone
  clear             erase stored history
  pair              start BLE advertising so the phone can pair
  hci               list Bluetooth adapters that support LE
"""

import argparse
import datetime
import json
import os
import sys
import time

import gi

gi.require_version("GLib", "2.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

OBSERVER = "ancs4linux.Observer"
ADVERTISING = "ancs4linux.Advertising"
OBJ_PATH = "/"

# Apple Notification Center Service. A connected device exposing this is the
# phone we are mirroring.
ANCS_UUID = "7905f431-b5ce-4e99-a40f-4b1e122d00d0"

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "iphone",
)
HISTORY_PATH = os.path.join(STATE_DIR, "history.jsonl")
DEFAULT_LIMIT = 200


def ancs_date_to_epoch(text):
    """ANCS sends the phone's own timestamp as yyyyMMdd'T'HHmmSS, local time.

    That beats our arrival time, which drifts when the phone reconnects and
    replays what it queued while away.
    """
    try:
        return datetime.datetime.strptime(str(text), "%Y%m%dT%H%M%S").timestamp()
    except (ValueError, TypeError):
        return 0.0


def emit(obj):
    """Write one JSON event to stdout. Line-buffered so QML sees it at once."""
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def system_bus():
    return Gio.bus_get_sync(Gio.BusType.SYSTEM, None)


# --------------------------------------------------------------------------
# History
# --------------------------------------------------------------------------


def load_history(limit):
    try:
        with open(HISTORY_PATH, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        return []
    except OSError:
        return []

    items = []
    for line in lines[-limit:]:
        line = line.strip()
        if not line:
            continue
        try:
            items.append(json.loads(line))
        except ValueError:
            continue
    return items


def append_history(entry, limit):
    """Append one notification, trimming the file when it outgrows the cap."""
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        with open(HISTORY_PATH, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        return

    # Trim lazily: rewriting on every notification would be wasteful, so only
    # compact once the file has drifted well past the cap.
    try:
        with open(HISTORY_PATH, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
        if len(lines) > limit * 2:
            tmp = HISTORY_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.writelines(lines[-limit:])
            os.replace(tmp, HISTORY_PATH)
    except OSError:
        pass


# --------------------------------------------------------------------------
# Phone connection state, read from BlueZ
# --------------------------------------------------------------------------


def device_battery(interfaces):
    """BlueZ exposes the phone's battery on the same object, when it has one."""
    battery = interfaces.get("org.bluez.Battery1")
    if not battery:
        return -1
    try:
        return int(battery.get("Percentage", -1))
    except (TypeError, ValueError):
        return -1


def gatt_connected(device):
    """ANCS and AMS need a live GATT link, which an iPhone serves over LE or
    over BR/EDR. Device1.Connected stays true over an A2DP or HFP link whose
    ATT channel is down, where every GATT call answers "Not connected";
    ServicesResolved drops with that channel.
    """
    return bool(device.get("Connected")) and bool(device.get("ServicesResolved"))


def connected_phone(bus):
    """Return {name, address, battery, connected, linked, paired} for the ANCS phone
    BlueZ knows, GATT-connected first, then one only bonded, else None."""
    try:
        reply = bus.call_sync(
            "org.bluez",
            "/",
            "org.freedesktop.DBus.ObjectManager",
            "GetManagedObjects",
            None,
            GLib.VariantType("(a{oa{sa{sv}}})"),
            Gio.DBusCallFlags.NONE,
            4000,
            None,
        )
    except GLib.Error:
        return None

    objects = reply.unpack()[0]
    best = None
    best_rank = 0
    for _path, interfaces in objects.items():
        device = interfaces.get("org.bluez.Device1")
        if not device:
            continue
        connected = gatt_connected(device)
        paired = bool(device.get("Paired"))
        if not connected and not paired:
            continue
        uuids = [str(u).lower() for u in device.get("UUIDs", [])]
        # Some iPhones only advertise ANCS after the GATT client subscribes.
        # An Apple-looking device is the weaker signal.
        if ANCS_UUID in uuids:
            rank = 2
        elif device.get("Icon") == "phone":
            rank = 1
        else:
            continue
        rank += 4 if connected else 0
        if rank <= best_rank:
            continue
        best_rank = rank
        best = {
            "name": device.get("Alias") or device.get("Name") or "iPhone",
            "address": device.get("Address", ""),
            "battery": device_battery(interfaces) if connected else -1,
            "connected": connected,
            "linked": bool(device.get("Connected")),
            "paired": paired,
        }
    return best


# --------------------------------------------------------------------------
# listen
# --------------------------------------------------------------------------


def cmd_listen(args):
    limit = args.limit
    bus = system_bus()

    emit({"type": "history", "items": load_history(limit)})

    def on_show(_conn, _sender, _path, _iface, _member, params, _data):
        try:
            payload = json.loads(params.unpack()[0])
        except (ValueError, IndexError):
            return
        # Prefer the phone's timestamp; fall back to arrival time.
        stamp = ancs_date_to_epoch(payload.get("date")) or time.time()
        entry = {
            "type": "notification",
            "id": payload.get("id"),
            "appId": payload.get("app_id") or "",
            "appName": payload.get("app_name") or payload.get("app_id") or "Unknown",
            "title": payload.get("title") or "",
            "subtitle": payload.get("subtitle") or "",
            "body": payload.get("body") or "",
            "deviceName": payload.get("device_name") or "",
            "deviceHandle": payload.get("device_handle") or "",
            "positiveAction": payload.get("positive_action"),
            "negativeAction": payload.get("negative_action"),
            # iOS classifies every notification for us; no user rules needed.
            "category": int(payload.get("category_id") or 0),
            "categoryCount": int(payload.get("category_count") or 0),
            "silent": payload.get("silent") is True,
            "important": payload.get("important") is True,
            "preexisting": payload.get("preexisting") is True,
            # Notification ids are only valid within one connection.
            "session": int(payload.get("session") or 0),
            "ts": stamp,
        }
        append_history(entry, limit)
        emit(entry)

    def on_dismiss(_conn, _sender, _path, _iface, _member, params, _data):
        try:
            emit({"type": "dismiss", "id": params.unpack()[0]})
        except IndexError:
            pass

    bus.signal_subscribe(
        OBSERVER, OBSERVER, "ShowNotification", OBJ_PATH, None,
        Gio.DBusSignalFlags.NONE, on_show, None,
    )
    bus.signal_subscribe(
        OBSERVER, OBSERVER, "DismissNotification", OBJ_PATH, None,
        Gio.DBusSignalFlags.NONE, on_dismiss, None,
    )
    bus.signal_subscribe(
        ADVERTISING, ADVERTISING, "PairingCode", OBJ_PATH, None,
        Gio.DBusSignalFlags.NONE,
        lambda *a: emit({"type": "pairingCode", "code": a[5].unpack()[0]}),
        None,
    )

    # Daemon availability, so the bar can say "not running" instead of lying
    # with a silent empty list.
    state = {"observer": False, "connected": False, "linked": False, "paired": False,
             "deviceName": "", "address": "", "battery": -1}

    def daemon_installed():
        return any(
            os.path.exists(os.path.join(d, "ancs4linux-observer"))
            for d in ("/usr/local/bin", "/usr/bin")
        )

    def push_status():
        emit({
            "type": "status",
            "observer": state["observer"],
            "connected": state["connected"],
            "linked": state["linked"],
            "paired": state["paired"],
            "deviceName": state["deviceName"],
            "address": state["address"],
            "battery": state["battery"],
            "installed": daemon_installed(),
        })

    def on_name(_conn, _name, _owner):
        state["observer"] = True
        push_status()

    def on_name_lost(_conn, _name):
        state["observer"] = False
        state["connected"] = False
        state["linked"] = False
        state["paired"] = False
        state["deviceName"] = ""
        state["address"] = ""
        state["battery"] = -1
        push_status()

    Gio.bus_watch_name(
        Gio.BusType.SYSTEM, OBSERVER, Gio.BusNameWatcherFlags.NONE,
        on_name, on_name_lost,
    )

    def poll_connection():
        phone = connected_phone(bus) or {
            "name": "", "address": "", "battery": -1,
            "connected": False, "linked": False, "paired": False,
        }
        fresh = {
            "connected": phone["connected"],
            "linked": phone["linked"],
            "paired": phone["paired"],
            "deviceName": phone["name"],
            "address": phone["address"],
            "battery": phone["battery"],
        }
        if any(state[k] != v for k, v in fresh.items()):
            state.update(fresh)
            push_status()
        return True

    poll_connection()
    GLib.timeout_add_seconds(5, poll_connection)

    GLib.MainLoop().run()


# --------------------------------------------------------------------------
# one-shot commands
# --------------------------------------------------------------------------


# ANCS answers the control point with its own error codes. Without this
# mapping the user just sees a raw ATT number.
ANCS_ERRORS = {
    "0xa0": "The phone did not understand the command",
    "0xa1": "The phone rejected the command",
    "0xa2": "That notification is no longer on the phone",
    "0xa3": "The phone could not perform that action",
}


def explain_att_error(text):
    lowered = str(text).lower()
    for code, message in ANCS_ERRORS.items():
        if code in lowered:
            return message
    return None


def action_log(text):
    """Append to a log, so a failed action can be diagnosed after the fact.

    Actions are hard to catch live: a call is actionable for seconds, and the
    daemon silently ignores anything it does not recognise.
    """
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        with open(os.path.join(STATE_DIR, "actions.log"), "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (datetime.datetime.now().isoformat(timespec="seconds"), text))
    except OSError:
        pass


def cmd_invoke(args):
    """Act on a notification on the phone itself (clear it, answer a call...)."""
    bus = system_bus()
    action_log("invoke id=%s kind=%s handle=%s" % (args.id, args.kind, args.handle))

    # The daemon returns silently when it does not know the device handle, so
    # check the handle is one it is actually tracking before blaming the phone.
    try:
        known = bus.call_sync(
            "org.bluez", args.handle, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("org.bluez.Device1", "Connected")),
            GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 3000, None,
        ).unpack()[0]
        action_log("  device connected=%s" % known)
    except GLib.Error as err:
        action_log("  device lookup failed: %s" % err)

    try:
        bus.call_sync(
            OBSERVER, OBJ_PATH, OBSERVER, "InvokeDeviceAction",
            GLib.Variant("(sub)", (args.handle, int(args.id), args.kind == "positive")),
            None, Gio.DBusCallFlags.NONE, 5000, None,
        )
        action_log("  InvokeDeviceAction returned OK")
    except GLib.Error as err:
        action_log("  InvokeDeviceAction FAILED: %s" % err)
        emit({"type": "error", "message": explain_att_error(err) or str(err)})
        return 1
    return 0


def cmd_clear(_args):
    try:
        os.remove(HISTORY_PATH)
    except FileNotFoundError:
        pass
    except OSError as err:
        emit({"type": "error", "message": str(err)})
        return 1
    return 0


def forget_device(bus, hci_address, address):
    """Remove one bonded device from the adapter advertising for pairing.

    A phone that forgot this machine refuses the keys BlueZ still holds, and
    iOS then fails every new pairing until they are gone.
    """
    reply = bus.call_sync(
        "org.bluez", "/", "org.freedesktop.DBus.ObjectManager",
        "GetManagedObjects", None, GLib.VariantType("(a{oa{sa{sv}}})"),
        Gio.DBusCallFlags.NONE, 4000, None,
    )
    objects = reply.unpack()[0]
    adapter = None
    for path, interfaces in objects.items():
        props = interfaces.get("org.bluez.Adapter1")
        if props and props.get("Address", "").upper() == hci_address.upper():
            adapter = path
    if adapter is None:
        return False
    for path, interfaces in objects.items():
        device = interfaces.get("org.bluez.Device1")
        if (device and path.startswith(adapter + "/")
                and device.get("Address", "").upper() == address.upper()):
            bus.call_sync(
                "org.bluez", adapter, "org.bluez.Adapter1", "RemoveDevice",
                GLib.Variant("(o)", (path,)), None, Gio.DBusCallFlags.NONE,
                10000, None,
            )
            return True
    return False


def cmd_pair(args):
    """Advertise over BLE so the iPhone can find and pair with this machine."""
    bus = system_bus()
    try:
        adapters = bus.call_sync(
            ADVERTISING, OBJ_PATH, ADVERTISING, "GetAllHci",
            None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, 5000, None,
        ).unpack()[0]
        if not adapters:
            emit({"type": "error", "message": "No Bluetooth LE adapter found"})
            return 1
        address = args.hci or adapters[0]
        if args.forget and forget_device(bus, address, args.forget):
            emit({"type": "forgot", "address": args.forget})
        bus.call_sync(
            ADVERTISING, OBJ_PATH, ADVERTISING, "EnableAdvertising",
            GLib.Variant("(ss)", (address, args.name)),
            None, Gio.DBusCallFlags.NONE, 60000, None,
        )
        emit({"type": "advertising", "hci": address, "name": args.name})
    except GLib.Error as err:
        emit({"type": "error", "message": str(err)})
        return 1
    return 0


def cmd_hci(_args):
    bus = system_bus()
    try:
        adapters = bus.call_sync(
            ADVERTISING, OBJ_PATH, ADVERTISING, "GetAllHci",
            None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, 5000, None,
        ).unpack()[0]
        emit({"type": "hci", "adapters": adapters})
    except GLib.Error as err:
        emit({"type": "error", "message": str(err)})
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")

    p_listen = sub.add_parser("listen")
    p_listen.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    p_listen.set_defaults(func=cmd_listen)

    p_invoke = sub.add_parser("invoke")
    p_invoke.add_argument("--handle", required=True)
    p_invoke.add_argument("--id", required=True)
    p_invoke.add_argument("--kind", choices=["positive", "negative"], default="negative")
    p_invoke.set_defaults(func=cmd_invoke)

    sub.add_parser("clear").set_defaults(func=cmd_clear)

    p_pair = sub.add_parser("pair")
    p_pair.add_argument("--name", default="Omarchy")
    p_pair.add_argument("--hci", default="")
    p_pair.add_argument("--forget", default="")
    p_pair.set_defaults(func=cmd_pair)

    sub.add_parser("hci").set_defaults(func=cmd_hci)

    args = parser.parse_args()
    if not getattr(args, "func", None):
        args = parser.parse_args(["listen"])
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
